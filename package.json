{
  "name": "image-compressor-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "benchmark": "npm run build && node bench/run.mjs",
    "benchmark:quick": "npm run build && node bench/run.mjs --counts 8 --scenarios jpeg-photo,jpeg-photo-resize,webp-photo,png-screenshot --label quick",
    "benchmark:scale": "npm run build && node bench/run.mjs --counts 500,1000 --scenarios jpeg-photo,png-screenshot,jpeg-mixed --label scale-500-1000 --timeout 600000"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@preact/signals": "^2.11.2",
    "fflate": "^0.8.3",
    "imagequant": "^0.1.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@preact/preset-vite": "^2.10.6",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
